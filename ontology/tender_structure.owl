  <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Competes_In_Region">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:propertyChainAxiom rdf:nodeID="nba2fe076ea0c48aea84c16c17c3724afb61"/>
    <skos:altLabel xml:lang="fr">Région de soumission</skos:altLabel>
    <skos:altLabel xml:lang="fr">Territoire d'activité</skos:altLabel>
    <skos:definition xml:lang="fr">Région(s) administrative(s) marocaine(s) où un entrepreneur a déposé des offres (gagnées ou non). Indique son territoire de prospection. Inférée via Formulate_Bid ∘ Is_Bid_in ∘ Is_Proces_Verbal_of ∘ Is_Located_In.</skos:definition>
