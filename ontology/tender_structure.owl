  <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Serve_Region">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:propertyChainAxiom rdf:nodeID="nba2fe076ea0c48aea84c16c17c3724afb51"/>
    <skos:altLabel xml:lang="fr">Zone d'intervention</skos:altLabel>
    <skos:definition xml:lang="fr">Région administrative marocaine dans laquelle un prestataire opère, inférée automatiquement : si un appel d'offres est situé dans une région (ts:Is_Located_In) et qu'un prestataire remporte cet appel (ts:Is_Awarded_To), alors ce prestataire sert cette région via ts:Serve_Region.</skos:definition>
    <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
    <skos:prefLabel xml:lang="fr">Intervient dans la région</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nba2fe076ea0c48aea84c16c17c3724afb18">
    <rdf:first rdf:nodeID="nba2fe076ea0c48aea84c16c17c3724afb15"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
