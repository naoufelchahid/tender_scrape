    <skos:altLabel xml:lang="fr">Groupement avec</skos:altLabel>
    <skos:definition xml:lang="fr">Lie deux entrepreneurs ayant soumissionné conjointement sur la même instance de TenderBids (offre groupée / consortium). Propriété symétrique, inférée via la chaîne Formulate_Bid ∘ ⁻Formulate_Bid sur une même offre partagée.</skos:definition>
    <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
    <skos:prefLabel xml:lang="fr">Est partenaire de</skos:prefLabel>
  </rdf:Description>
