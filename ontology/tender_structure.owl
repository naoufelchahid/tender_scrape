  <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Competitor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
    <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
    <owl:propertyChainAxiom rdf:nodeID="nba2fe076ea0c48aea84c16c17c3724afb53"/>
    <skos:altLabel xml:lang="fr">Concurrent de</skos:altLabel>
    <skos:altLabel xml:lang="fr">En compétition avec</skos:altLabel>
    <skos:definition xml:lang="fr">Lie deux entrepreneurs ayant soumissionné sur le même appel d'offres. Propriété réflexive (tout entrepreneur est son propre concurrent) et symétrique (si A est concurrent de B, B est concurrent de A). Inférée automatiquement via la chaîne Formulate_Bid ∘ ⁻Formulate_Bid.</skos:definition>
    <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
    <skos:prefLabel xml:lang="fr">Est concurrent de</skos:prefLabel>
  </rdf:Description>
