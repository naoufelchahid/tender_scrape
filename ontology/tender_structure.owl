    <owl:propertyChainAxiom rdf:nodeID="nba2fe076ea0c48aea84c16c17c3724afb6"/>
    <skos:altLabel xml:lang="fr">Concurrent régional</skos:altLabel>
    <skos:altLabel xml:lang="fr">Pair géographique de marché</skos:altLabel>
    <skos:definition xml:lang="fr">Lie deux entrepreneurs qui ont tous deux soumissionné dans la même région, constituant ainsi leurs pairs sur le marché géographique local. Propriété symétrique, inférée via Competes_In_Region ∘ ⁻Competes_In_Region.</skos:definition>
    <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
    <skos:prefLabel xml:lang="fr">Est co-soumissionnaire régional de</skos:prefLabel>
  </rdf:Description>
