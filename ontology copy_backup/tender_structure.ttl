@prefix ts: <http://www.tenderintelligence.io/ontology/tender-structure#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix activity: <http://www.tenderintelligence.io/ontology/activity-domains#> .
@prefix regions: <http://www.tenderintelligence.io/ontology/morocco-regions#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.tenderintelligence.io/ontology/activity-domains#code
activity:code rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#hasTopConcept
skos:hasTopConcept rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#narrower
skos:narrower rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#notation
skos:notation rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
skos:topConceptOf rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.co-ode.org/ontologies/ont.owl#Executes
<http://www.co-ode.org/ontologies/ont.owl#Executes> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain ts:Contractor ;
                                                    rdfs:range ts:InExecution ;
                                                    skos:altLabel "En cours d'exécution"@fr ;
                                                    skos:definition "Indique que l'entrepreneur est actuellement en train d'exécuter le marché."@fr ;
                                                    skos:inScheme ts:TenderStructureScheme ;
                                                    skos:prefLabel "Exécute"@fr .


###  http://www.co-ode.org/ontologies/ont.owl#Has_Execution
<http://www.co-ode.org/ontologies/ont.owl#Has_Execution> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain ts:TenderResults ;
                                                         rdfs:range ts:TenderExecution ;
                                                         skos:altLabel "Suivi d'exécution"@fr ;
                                                         skos:definition "Lie le résultat de l'appel d'offres à son état ou phase d'exécution."@fr ;
                                                         skos:inScheme ts:TenderStructureScheme ;
                                                         skos:prefLabel "A pour phase d'exécution"@fr .


###  http://www.co-ode.org/ontologies/ont.owl#Has_executed
<http://www.co-ode.org/ontologies/ont.owl#Has_executed> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain ts:Contractor ;
                                                        rdfs:range ts:TenderExecuted ;
                                                        skos:altLabel "Marché achevé"@fr ;
                                                        skos:definition "Indique que l'entrepreneur a complètement exécuté et achevé le marché."@fr ;
                                                        skos:inScheme ts:TenderStructureScheme ;
                                                        skos:prefLabel "A exécuté"@fr .


###  http://www.co-ode.org/ontologies/ont.owl#Has_resilied
<http://www.co-ode.org/ontologies/ont.owl#Has_resilied> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain ts:Contractor ;
                                                        rdfs:range ts:TenderResilied ;
                                                        skos:altLabel "Marché annulé"@fr ;
                                                        skos:definition "Indique que le marché confié à l'entrepreneur a été résilié avant son terme."@fr ;
                                                        skos:inScheme ts:TenderStructureScheme ;
                                                        skos:prefLabel "A été résilié"@fr .


###  http://www.co-ode.org/ontologies/ont.owl#Is_Executed
<http://www.co-ode.org/ontologies/ont.owl#Is_Executed> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain ts:TenderResults ;
                                                       rdfs:range ts:TenderExecuted ;
                                                       skos:altLabel "Achevé"@fr ;
                                                       skos:definition "Indique que le marché issu de ce résultat a été entièrement exécuté."@fr ;
                                                       skos:inScheme ts:TenderStructureScheme ;
                                                       skos:prefLabel "Est exécuté"@fr .


###  http://www.co-ode.org/ontologies/ont.owl#Is_The_Unit_Price_for
<http://www.co-ode.org/ontologies/ont.owl#Is_The_Unit_Price_for> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain ts:TenderBids ;
                                                                 rdfs:range ts:Articles ;
                                                                 skos:altLabel "Prix de l'article soumissionné"@fr ;
                                                                 skos:definition "Lie l'offre globale (soumission) aux prix unitaires proposés pour chaque article."@fr ;
                                                                 skos:inScheme ts:TenderStructureScheme ;
                                                                 skos:prefLabel "Est le prix unitaire pour"@fr .


###  http://www.co-ode.org/ontologies/ont.owl#Is_infructueux
<http://www.co-ode.org/ontologies/ont.owl#Is_infructueux> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain ts:TenderResults ;
                                                          rdfs:range ts:TenderInfructeux ;
                                                          skos:altLabel "Sans suite"@fr ;
                                                          skos:definition "Indique que le résultat de l'appel d'offres a été déclaré infructueux."@fr ;
                                                          skos:inScheme ts:TenderStructureScheme ;
                                                          skos:prefLabel "Est infructueux"@fr .


###  http://www.co-ode.org/ontologies/ont.owl#Is_resilied
<http://www.co-ode.org/ontologies/ont.owl#Is_resilied> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain ts:TenderResults ;
                                                       rdfs:range ts:TenderResilied ;
                                                       skos:altLabel "Annulé"@fr ;
                                                       skos:definition "Indique que le marché issu de ce résultat a été résilié."@fr ;
                                                       skos:inScheme ts:TenderStructureScheme ;
                                                       skos:prefLabel "Est résilié"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid
ts:Formulate_Bid rdf:type owl:ObjectProperty ;
                 rdfs:domain ts:Contractor ;
                 rdfs:range ts:TenderBids ;
                 skos:altLabel "Soumet"@fr ;
                 skos:definition "Lie le Concurrent (Entrepreneur) à l'Offre (Soumission) qu'il a préparée."@fr ;
                 skos:inScheme ts:TenderStructureScheme ;
                 skos:prefLabel "A formulé l'offre"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Article
ts:Has_Article rdf:type owl:ObjectProperty ;
               rdfs:domain ts:Bordereaux ;
               rdfs:range ts:Articles ;
               skos:altLabel "Comprend l'article"@fr ;
               skos:definition "Lie le Bordereau des Prix à ses articles ou lignes de prestations spécifiques."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Contient une ligne de prix"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Article_Category
ts:Has_Article_Category rdf:type owl:ObjectProperty ;
                        rdfs:domain ts:Articles ;
                        rdfs:range skos:Concept ;
                        skos:altLabel "Spécialité de l'article"@fr ;
                        skos:definition "Lie un article du bordereau à un concept SKOS précis dans le schéma du domaine d'activité de l'appel d'offres parent (ex : activity:TravauxDelectricite pour un article d'électricité). Le concept cible doit appartenir au même skos:ConceptScheme que la catégorie du marché."@fr ;
                        skos:inScheme ts:TenderStructureScheme ;
                        skos:prefLabel "A pour sous-catégorie d'article"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Bid
ts:Has_Bid rdf:type owl:ObjectProperty ;
           rdfs:domain ts:TenderResults ;
           rdfs:range ts:TenderBids ;
           skos:altLabel "Offres déposées"@fr ;
           skos:definition "Relation inverse; lie l'Appel d'Offres aux offres concurrentes déposées."@fr ;
           skos:inScheme ts:TenderStructureScheme ;
           skos:prefLabel "A reçu comme Offre"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau
ts:Has_Bordereau rdf:type owl:ObjectProperty ;
                 rdfs:domain ts:Tenders ;
                 rdfs:range ts:Bordereaux ;
                 skos:altLabel "Inclut le Bordereau"@fr ;
                 skos:definition "Lie l'Appel d'Offres ou le CPS au Bordereau des Prix (BDP)."@fr ;
                 skos:inScheme ts:TenderStructureScheme ;
                 skos:prefLabel "Contient un BDP"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Category
ts:Has_Category rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ts:Tenders ;
                rdfs:range skos:ConceptScheme ;
                skos:altLabel "Domaine d'activité"@fr ;
                skos:definition "Lie l'appel d'offres à son domaine d'activité principal (Travaux, Fournitures ou Services) selon la nomenclature marocaine des marchés publics. Pointe vers l'un des trois concepts racines : activity:Travaux, activity:Fournitures ou activity:Services."@fr ;
                skos:inScheme ts:TenderStructureScheme ;
                skos:prefLabel "A pour catégorie"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Located_In
ts:Is_Located_In rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain ts:Tenders ;
                 rdfs:range skos:Concept ;
                 skos:altLabel "Région de l'AO"@fr ;
                 skos:definition "Lie l'appel d'offres à la région administrative marocaine dans laquelle il est publié ou exécuté. La valeur cible est un individu du schéma regions:MoroccoRegionsScheme (ex : regions:CasablancaSettat)."@fr ;
                 skos:inScheme ts:TenderStructureScheme ;
                 skos:prefLabel "Est situé dans"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Serve_Region
ts:Serve_Region rdf:type owl:ObjectProperty ;
                rdfs:domain ts:Contractor ;
                rdfs:range skos:Concept ;
                owl:propertyChainAxiom ( [ owl:inverseOf ts:IsAwarded_to ] ts:Is_Located_In ) ;
                skos:altLabel "Zone d'intervention"@fr ;
                skos:definition "Région administrative marocaine dans laquelle un prestataire opère, inférée automatiquement : si un appel d'offres est situé dans une région (ts:Is_Located_In) et qu'un prestataire remporte cet appel (ts:Is_Awarded_To), alors ce prestataire sert cette région via ts:Serve_Region."@fr ;
                skos:inScheme ts:TenderStructureScheme ;
                skos:prefLabel "Intervient dans la région"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Reglement_Consultation
ts:Has_Reglement_Consultation rdf:type owl:ObjectProperty ;
                              rdfs:domain ts:Tenders ;
                              rdfs:range ts:TenderReglement ;
                              skos:altLabel "A pour Règlement"@fr ;
                              skos:definition "Lie l'appel d'offres au document fixant les règles de la consultation (RC)."@fr ;
                              skos:inScheme ts:TenderStructureScheme ;
                              skos:prefLabel "Est régi par le RC"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_specifications
ts:Has_specifications rdf:type owl:ObjectProperty ;
                      rdfs:domain ts:Tenders ;
                      rdfs:range ts:TenderSpecifications ;
                      skos:altLabel "Régi par le CPS"@fr ;
                      skos:definition "Lie l'appel d'offres au Cahier des Prescriptions Spéciales (CPS)."@fr ;
                      skos:inScheme ts:TenderStructureScheme ;
                      skos:prefLabel "Contient les spécifications CPS"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to
ts:IsAwarded_to rdf:type owl:ObjectProperty ;
                rdfs:domain ts:Tenders ;
                rdfs:range ts:Contractor ;
                owl:propertyChainAxiom ( ts:Is_Opened
                                         ts:Is_Winner_Bid
                                         ts:Is_Bid_of
                                       ) ;
                skos:altLabel "Adjugé à"@fr ;
                skos:definition "Lie l'Appel d'Offres au Concurrent (Entrepreneur) retenu comme attributaire. Inférée via la chaîne Is_Opened ∘ Is_Winner_Bid ∘ Is_Bid_of."@fr ;
                skos:inScheme ts:TenderStructureScheme ;
                skos:prefLabel "Est attribué à"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Article_of
ts:Is_Article_of rdf:type owl:ObjectProperty ;
                 rdfs:domain ts:Articles ;
                 rdfs:range ts:Bordereaux ;
                 skos:altLabel "Ligne du Bordereau"@fr ;
                 skos:definition "Relation inverse; connecte un article de prix au Bordereau des Prix parent."@fr ;
                 skos:inScheme ts:TenderStructureScheme ;
                 skos:prefLabel "Fait partie du BDP"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_in
ts:Is_Bid_in rdf:type owl:ObjectProperty ;
             rdfs:domain ts:TenderBids ;
             rdfs:range ts:TenderResults ;
             skos:altLabel "Offre déposée pour"@fr ;
             skos:definition "Lie une Offre (Soumission) à l'Appel d'Offres ou Lot correspondant."@fr ;
             skos:inScheme ts:TenderStructureScheme ;
             skos:prefLabel "A été soumissionnée pour"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_of
ts:Is_Bid_of rdf:type owl:ObjectProperty ;
             rdfs:domain ts:TenderBids ;
             rdfs:range ts:Contractor ;
             skos:altLabel "Soumis par"@fr ;
             skos:definition "Relation inverse; lie l'Offre à l'Entrepreneur (Concurrent) qui l'a déposée."@fr ;
             skos:inScheme ts:TenderStructureScheme ;
             skos:prefLabel "Est l'offre de"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Bordereau_of
ts:Is_Bordereau_of rdf:type owl:ObjectProperty ;
                   rdfs:domain ts:Bordereaux ;
                   rdfs:range ts:Tenders ;
                   skos:altLabel "BDP rattaché à"@fr ;
                   skos:definition "Relation inverse; lie le Bordereau des Prix à l'appel d'offres correspondant."@fr ;
                   skos:inScheme ts:TenderStructureScheme ;
                   skos:prefLabel "Est le BDP de"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Competitor
ts:Is_Competitor rdf:type owl:ObjectProperty ,
                          owl:SymmetricProperty ;
                 rdfs:domain ts:Contractor ;
                 rdfs:range ts:Contractor ;
                 owl:propertyChainAxiom ( ts:Formulate_Bid
                                          [ owl:inverseOf ts:Formulate_Bid
                                          ]
                                        ) ;
                 skos:altLabel "Concurrent de"@fr ,
                               "En compétition avec"@fr ;
                 skos:definition "Lie deux entrepreneurs ayant soumissionné sur le même appel d'offres. Propriété réflexive (tout entrepreneur est son propre concurrent) et symétrique (si A est concurrent de B, B est concurrent de A). Inférée automatiquement via la chaîne Formulate_Bid ∘ ⁻Formulate_Bid."@fr ;
                 skos:inScheme ts:TenderStructureScheme ;
                 skos:prefLabel "Est concurrent de"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Opened
ts:Is_Opened rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain ts:Tenders ;
             rdfs:range ts:TenderResults ;
             skos:altLabel "Plis ouverts (PV)"@fr ;
             skos:definition "Lie l'Appel d'Offres au Procès-Verbal d'ouverture des plis."@fr ;
             skos:inScheme ts:TenderStructureScheme ;
             skos:prefLabel "A été ouvert lors du PV"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Partner
ts:Is_Partner rdf:type owl:ObjectProperty ,
                       owl:SymmetricProperty ;
              rdfs:domain ts:Contractor ;
              rdfs:range ts:Contractor ;
              owl:propertyChainAxiom ( ts:Formulate_Bid
                                       [ owl:inverseOf ts:Formulate_Bid
                                       ]
                                     ) ;
              skos:altLabel "Associé de"@fr ,
                            "Groupement avec"@fr ;
              skos:definition "Lie deux entrepreneurs ayant soumissionné conjointement sur la même instance de TenderBids (offre groupée / consortium). Propriété symétrique, inférée via la chaîne Formulate_Bid ∘ ⁻Formulate_Bid sur une même offre partagée."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Est partenaire de"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Proces_Verbal_of
ts:Is_Proces_Verbal_of rdf:type owl:ObjectProperty ;
                       rdfs:domain ts:TenderResults ;
                       rdfs:range ts:Tenders ;
                       skos:altLabel "PV relatif à l'AO"@fr ;
                       skos:definition "Relation inverse; lie le Procès-Verbal à l'Appel d'Offres concerné."@fr ;
                       skos:inScheme ts:TenderStructureScheme ;
                       skos:prefLabel "Est le PV d'ouverture de"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Reglement_Consultation_Of
ts:Is_Reglement_Consultation_Of rdf:type owl:ObjectProperty ;
                                rdfs:domain ts:TenderReglement ;
                                rdfs:range ts:Tenders ;
                                skos:altLabel "Régit l'AO"@fr ;
                                skos:definition "Relation inverse; lie le Règlement de Consultation à son Appel d'Offres."@fr ;
                                skos:inScheme ts:TenderStructureScheme ;
                                skos:prefLabel "Est le RC de"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Rejected_Bid
ts:Is_Rejected_Bid rdf:type owl:ObjectProperty ;
                   rdfs:domain ts:TenderBids ;
                   rdfs:range ts:TenderResults ;
                   skos:altLabel "Rejeté pour l'AO"@fr ;
                   skos:definition "Relation inverse; indique qu'une offre spécifique a été rejetée pour un AO donné."@fr ;
                   skos:inScheme ts:TenderStructureScheme ;
                   skos:prefLabel "Est une offre écartée de"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Winner_Bid
ts:Is_Winner_Bid rdf:type owl:ObjectProperty ;
                 rdfs:domain ts:TenderResults ;
                 rdfs:range ts:TenderBids ;
                 skos:altLabel "Soumission gagnante"@fr ;
                 skos:definition "Indique que l'offre a été retenue et a remporté l'Appel d'Offres."@fr ;
                 skos:inScheme ts:TenderStructureScheme ;
                 skos:prefLabel "Est l'offre retenue pour"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_specifications_of
ts:Is_specifications_of rdf:type owl:ObjectProperty ;
                        rdfs:domain ts:TenderSpecifications ;
                        rdfs:range ts:Tenders ;
                        skos:altLabel "Spécifie l'AO"@fr ;
                        skos:definition "Relation inverse; lie le Cahier des Prescriptions Spéciales à son Appel d'Offres."@fr ;
                        skos:inScheme ts:TenderStructureScheme ;
                        skos:prefLabel "Est le CPS de"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Launched
ts:Launched rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain ts:Buyers ;
            rdfs:range ts:Tenders ;
            skos:altLabel "Est l'initiateur de"@fr ;
            skos:definition "Relation inverse de :Launched_by; connecte l'Acheteur à ses Appels d'Offres."@fr ;
            skos:inScheme ts:TenderStructureScheme ;
            skos:prefLabel "A lancé"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Launched_by
ts:Launched_by rdf:type owl:ObjectProperty ;
               rdfs:domain ts:Tenders ;
               rdfs:range ts:Buyers ;
               skos:altLabel "Initié par"@fr ;
               skos:definition "Indique l'Acheteur (Maître d'Ouvrage) responsable du lancement de l'appel d'offres."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Lancé par"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Rejected_Bid
ts:Rejected_Bid rdf:type owl:ObjectProperty ;
                rdfs:domain ts:TenderResults ;
                rdfs:range ts:TenderBids ;
                skos:altLabel "Offre écartée"@fr ;
                skos:definition "Lie l'Appel d'Offres (via le jury) à une offre qui a été écartée lors de l'évaluation."@fr ;
                skos:inScheme ts:TenderStructureScheme ;
                skos:prefLabel "A rejeté l'offre"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Supply
ts:Supply rdf:type owl:ObjectProperty ;
          rdfs:domain ts:Contractor ;
          rdfs:range ts:Articles ;
          owl:propertyChainAxiom ( [ owl:inverseOf ts:IsAwarded_to
                                   ]
                                   ts:Has_Bordereau
                                   ts:Has_Article
                                 ) ;
          skos:altLabel "Fournit"@fr ,
                        "Réalise"@fr ;
          skos:definition "Lie l'entrepreneur attributaire aux articles (prestations / fournitures) du bordereau du marché qui lui a été attribué. Inférée via la chaîne ⁻IsAwarded_to ∘ Has_Bordereau ∘ Has_Article."@fr ;
          skos:inScheme ts:TenderStructureScheme ;
          skos:prefLabel "Fournit l'Article"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Is_Competitor
# NOTE: Bug fix — previous chain was identical to Is_Partner (same bid), now corrected to 4-hop
ts:Is_Competitor owl:propertyChainAxiom ( ts:Formulate_Bid
                                           ts:Is_Bid_in
                                           ts:Has_Bid
                                           ts:Is_Bid_of
                                         ) .


# ─────────────────────────────────────────────────────────────────────
#  CONTRACTOR INTELLIGENCE  (8 new properties)
# ─────────────────────────────────────────────────────────────────────

###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Client
ts:Has_Client rdf:type owl:ObjectProperty ;
              rdfs:domain ts:Contractor ;
              rdfs:range ts:Buyers ;
              owl:propertyChainAxiom ( [ owl:inverseOf ts:IsAwarded_to ]
                                       ts:Launched_by
                                     ) ;
              skos:altLabel "Donneur d'ordre"@fr ,
                            "Maître d'ouvrage client"@fr ;
              skos:definition "Lie un entrepreneur à chaque acheteur public qui lui a attribué un marché. Inférée via la chaîne ⁻IsAwarded_to ∘ Launched_by."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "A pour Client"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Won
ts:Has_Won rdf:type owl:ObjectProperty ;
           rdfs:domain ts:Contractor ;
           rdfs:range ts:Tenders ;
           owl:propertyChainAxiom ( [ owl:inverseOf ts:IsAwarded_to ] ) ;
           skos:altLabel "Marchés remportés"@fr ,
                         "Adjudications"@fr ;
           skos:definition "Raccourci nommé reliant directement un entrepreneur à tous les appels d'offres qu'il a remportés. Alias inverse de ts:IsAwarded_to."@fr ;
           skos:inScheme ts:TenderStructureScheme ;
           skos:prefLabel "A remporté"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Competed_In
ts:Has_Competed_In rdf:type owl:ObjectProperty ;
                   rdfs:domain ts:Contractor ;
                   rdfs:range ts:Tenders ;
                   owl:propertyChainAxiom ( ts:Formulate_Bid
                                            ts:Is_Bid_in
                                            ts:Is_Proces_Verbal_of
                                          ) ;
                   skos:altLabel "A soumissionné pour"@fr ,
                                 "Participation AO"@fr ;
                   skos:definition "Lie un entrepreneur à tous les appels d'offres auxquels il a participé (gagnés ou perdus). Inférée via la chaîne Formulate_Bid ∘ Is_Bid_in ∘ Is_Proces_Verbal_of."@fr ;
                   skos:inScheme ts:TenderStructureScheme ;
                   skos:prefLabel "A participé à"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Lost_To
ts:Has_Lost_To rdf:type owl:ObjectProperty ;
               rdfs:domain ts:Contractor ;
               rdfs:range ts:Contractor ;
               owl:propertyChainAxiom ( ts:Is_Competitor
                                        [ owl:inverseOf ts:IsAwarded_to ]
                                        ts:IsAwarded_to
                                      ) ;
               skos:altLabel "Battu par"@fr ,
                             "Évincé par"@fr ;
               skos:definition "Lie un entrepreneur à ses concurrents qui ont remporté un marché face à lui. Inférée via Is_Competitor ∘ ⁻IsAwarded_to ∘ IsAwarded_to."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "A perdu face à"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Competes_In_Region
ts:Competes_In_Region rdf:type owl:ObjectProperty ;
                      rdfs:domain ts:Contractor ;
                      rdfs:range skos:Concept ;
                      owl:propertyChainAxiom ( ts:Formulate_Bid
                                               ts:Is_Bid_in
                                               ts:Is_Proces_Verbal_of
                                               ts:Is_Located_In
                                             ) ;
                      skos:altLabel "Région de soumission"@fr ,
                                    "Territoire d'activité"@fr ;
                      skos:definition "Région(s) administrative(s) marocaine(s) où un entrepreneur a déposé des offres (gagnées ou non). Indique son territoire de prospection. Inférée via Formulate_Bid ∘ Is_Bid_in ∘ Is_Proces_Verbal_of ∘ Is_Located_In."@fr ;
                      skos:inScheme ts:TenderStructureScheme ;
                      skos:prefLabel "Prospecte la région"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Operates_In_Category
ts:Operates_In_Category rdf:type owl:ObjectProperty ;
                        rdfs:domain ts:Contractor ;
                        rdfs:range skos:ConceptScheme ;
                        owl:propertyChainAxiom ( ts:Formulate_Bid
                                                 ts:Is_Bid_in
                                                 ts:Is_Proces_Verbal_of
                                                 ts:Has_Category
                                               ) ;
                        skos:altLabel "Secteur d'activité déclaré"@fr ,
                                      "Domaine marché"@fr ;
                        skos:definition "Catégorie(s) de haut niveau (Travaux, Fournitures, Services) dans lesquelles un entrepreneur a soumissionné. Inférée via Formulate_Bid ∘ Is_Bid_in ∘ Is_Proces_Verbal_of ∘ Has_Category."@fr ;
                        skos:inScheme ts:TenderStructureScheme ;
                        skos:prefLabel "Opère dans la catégorie"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Provides_Service_Category
ts:Provides_Service_Category rdf:type owl:ObjectProperty ;
                              rdfs:domain ts:Contractor ;
                              rdfs:range skos:Concept ;
                              owl:propertyChainAxiom ( ts:Supply
                                                       ts:Has_Article_Category
                                                     ) ;
                              skos:altLabel "Compétence prouvée"@fr ,
                                            "Sous-domaine réalisé"@fr ;
                              skos:definition "Concept SKOS granulaire (sous-domaine d'activité) que l'entrepreneur a démontré sa capacité à livrer, déduit des articles des marchés qui lui ont été attribués. Inférée via Supply ∘ Has_Article_Category."@fr ;
                              skos:inScheme ts:TenderStructureScheme ;
                              skos:prefLabel "Maîtrise la sous-catégorie"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Execution_Status
ts:Has_Execution_Status rdf:type owl:ObjectProperty ;
                        rdfs:domain ts:Contractor ;
                        rdfs:range ts:TenderExecution ;
                        owl:propertyChainAxiom ( [ owl:inverseOf ts:IsAwarded_to ]
                                                 ts:Is_Opened
                                                 [ owl:inverseOf <http://www.co-ode.org/ontologies/ont.owl#Has_Execution> ]
                                               ) ;
                        skos:altLabel "Etat d'avancement"@fr ,
                                      "Phase d'exécution en cours"@fr ;
                        skos:definition "Lie un entrepreneur à la phase d'exécution (en cours, exécuté, résilié) des marchés qui lui sont attribués. Inférée via ⁻IsAwarded_to ∘ Is_Opened ∘ ⁻Has_Execution."@fr ;
                        skos:inScheme ts:TenderStructureScheme ;
                        skos:prefLabel "A pour statut d'exécution"@fr .


# ─────────────────────────────────────────────────────────────────────
#  BUYER (MAÎTRE D'OUVRAGE) INTELLIGENCE  (4 new properties)
# ─────────────────────────────────────────────────────────────────────

###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Hired
ts:Has_Hired rdf:type owl:ObjectProperty ;
             rdfs:domain ts:Buyers ;
             rdfs:range ts:Contractor ;
             owl:propertyChainAxiom ( ts:Launched
                                      ts:IsAwarded_to
                                    ) ;
             skos:altLabel "Attributions contractuelles"@fr ,
                           "Prestataires engagés"@fr ;
             skos:definition "Lie un acheteur public à tous les entrepreneurs auxquels il a attribué des marchés. Relation inverse de Has_Client, inférée via Launched ∘ IsAwarded_to."@fr ;
             skos:inScheme ts:TenderStructureScheme ;
             skos:prefLabel "A contractualisé avec"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Buys_In_Category
ts:Buys_In_Category rdf:type owl:ObjectProperty ;
                    rdfs:domain ts:Buyers ;
                    rdfs:range skos:ConceptScheme ;
                    owl:propertyChainAxiom ( ts:Launched
                                             ts:Has_Category
                                           ) ;
                    skos:altLabel "Domaine d'achat public"@fr ,
                                  "Catégorie de marché achetée"@fr ;
                    skos:definition "Catégorie(s) de marché (Travaux, Fournitures, Services) dans lesquelles un acheteur public lance des appels d'offres. Inférée via Launched ∘ Has_Category."@fr ;
                    skos:inScheme ts:TenderStructureScheme ;
                    skos:prefLabel "Achète dans la catégorie"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Buyer_Operates_In_Region
ts:Buyer_Operates_In_Region rdf:type owl:ObjectProperty ;
                             rdfs:domain ts:Buyers ;
                             rdfs:range skos:Concept ;
                             owl:propertyChainAxiom ( ts:Launched
                                                      ts:Is_Located_In
                                                    ) ;
                             skos:altLabel "Rayonnement géographique"@fr ,
                                           "Zone de passation"@fr ;
                             skos:definition "Région(s) administrative(s) marocaine(s) dans lesquelles un acheteur public publie ses appels d'offres. Inférée via Launched ∘ Is_Located_In."@fr ;
                             skos:inScheme ts:TenderStructureScheme ;
                             skos:prefLabel "Lance des AO dans la région"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Rejected_Contractor
ts:Has_Rejected_Contractor rdf:type owl:ObjectProperty ;
                            rdfs:domain ts:Buyers ;
                            rdfs:range ts:Contractor ;
                            owl:propertyChainAxiom ( ts:Launched
                                                     ts:Is_Opened
                                                     ts:Rejected_Bid
                                                     ts:Is_Bid_of
                                                   ) ;
                            skos:altLabel "Soumissionnaire écarté"@fr ,
                                          "Offre rejetée de"@fr ;
                            skos:definition "Entrepreneurs dont les offres ont été rejetées lors d'au moins un AO lancé par cet acheteur. Inférée via Launched ∘ Is_Opened ∘ Rejected_Bid ∘ Is_Bid_of."@fr ;
                            skos:inScheme ts:TenderStructureScheme ;
                            skos:prefLabel "A rejeté la candidature de"@fr .


# ─────────────────────────────────────────────────────────────────────
#  TENDER INTELLIGENCE  (3 new properties)
# ─────────────────────────────────────────────────────────────────────

###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Participant
ts:Has_Participant rdf:type owl:ObjectProperty ;
                   rdfs:domain ts:Tenders ;
                   rdfs:range ts:Contractor ;
                   owl:propertyChainAxiom ( ts:Is_Opened
                                            ts:Has_Bid
                                            ts:Is_Bid_of
                                          ) ;
                   skos:altLabel "Soumissionnaires"@fr ,
                                 "Concurrents présents"@fr ;
                   skos:definition "Tous les entrepreneurs ayant déposé une offre pour cet appel d'offres, qu'elle soit retenue ou écartée. Inférée via Is_Opened ∘ Has_Bid ∘ Is_Bid_of."@fr ;
                   skos:inScheme ts:TenderStructureScheme ;
                   skos:prefLabel "A pour participant"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Rejected_Bidder
ts:Has_Rejected_Bidder rdf:type owl:ObjectProperty ;
                        rdfs:domain ts:Tenders ;
                        rdfs:range ts:Contractor ;
                        owl:propertyChainAxiom ( ts:Is_Opened
                                                 ts:Rejected_Bid
                                                 ts:Is_Bid_of
                                               ) ;
                        skos:altLabel "Offres écartées de"@fr ,
                                      "Non retenus"@fr ;
                        skos:definition "Entrepreneurs dont les offres ont été formellement rejetées lors de l'évaluation de cet AO. Inférée via Is_Opened ∘ Rejected_Bid ∘ Is_Bid_of."@fr ;
                        skos:inScheme ts:TenderStructureScheme ;
                        skos:prefLabel "A écarté le concurrent"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Includes_Article_Category
ts:Includes_Article_Category rdf:type owl:ObjectProperty ;
                              rdfs:domain ts:Tenders ;
                              rdfs:range skos:Concept ;
                              owl:propertyChainAxiom ( ts:Has_Bordereau
                                                       ts:Has_Article
                                                       ts:Has_Article_Category
                                                     ) ;
                              skos:altLabel "Sous-catégorie de prestation"@fr ,
                                            "Spécialité technique BDP"@fr ;
                              skos:definition "Relie directement un appel d'offres aux concepts SKOS granulaires des articles de son bordereau des prix, permettant la recherche sémantique par spécialité. Inférée via Has_Bordereau ∘ Has_Article ∘ Has_Article_Category."@fr ;
                              skos:inScheme ts:TenderStructureScheme ;
                              skos:prefLabel "Requiert la sous-spécialité"@fr .


# ─────────────────────────────────────────────────────────────────────
#  MARKET & GEO INTELLIGENCE  (2 new properties)
# ─────────────────────────────────────────────────────────────────────

###  http://www.tenderintelligence.io/ontology/tender-structure#Same_Region_Tender
ts:Same_Region_Tender rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ;
                      rdfs:domain ts:Tenders ;
                      rdfs:range ts:Tenders ;
                      owl:propertyChainAxiom ( ts:Is_Located_In
                                               [ owl:inverseOf ts:Is_Located_In ]
                                             ) ;
                      skos:altLabel "AO de la même région"@fr ,
                                    "Marché régional similaire"@fr ;
                      skos:definition "Relie deux appels d'offres publiés dans la même région marocaine. Propriété symétrique permettant le clustering géographique de marchés. Inférée via Is_Located_In ∘ ⁻Is_Located_In."@fr ;
                      skos:inScheme ts:TenderStructureScheme ;
                      skos:prefLabel "Est dans la même région que"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Co_Bidder_In_Region
ts:Co_Bidder_In_Region rdf:type owl:ObjectProperty ,
                                owl:SymmetricProperty ;
                       rdfs:domain ts:Contractor ;
                       rdfs:range ts:Contractor ;
                       owl:propertyChainAxiom ( ts:Competes_In_Region
                                                [ owl:inverseOf ts:Competes_In_Region ]
                                              ) ;
                       skos:altLabel "Concurrent régional"@fr ,
                                     "Pair géographique de marché"@fr ;
                       skos:definition "Lie deux entrepreneurs qui ont tous deux soumissionné dans la même région, constituant ainsi leurs pairs sur le marché géographique local. Propriété symétrique, inférée via Competes_In_Region ∘ ⁻Competes_In_Region."@fr ;
                       skos:inScheme ts:TenderStructureScheme ;
                       skos:prefLabel "Est co-soumissionnaire régional de"@fr .


#################################################################
#    Data properties
#################################################################

###  http://www.tenderintelligence.io/ontology/tender-structure#Article_Bid
ts:Article_Bid rdf:type owl:DatatypeProperty ;
               rdfs:domain ts:TenderBids ;
               rdfs:range xsd:decimal ;
               skos:altLabel "Prix Soumissionné"@fr ;
               skos:definition "Prix unitaire proposé pour un article spécifique par le concurrent."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Prix Unitaire Proposé"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Bid_Amount
ts:Bid_Amount rdf:type owl:DatatypeProperty ;
              rdfs:domain ts:TenderBids ;
              rdfs:range xsd:decimal ;
              skos:altLabel "Proposition Financière"@fr ;
              skos:definition "Montant global proposé par le soumissionnaire (entreprise)."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Montant de l'Offre"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Bid_For_Lot
ts:Bid_For_Lot rdf:type owl:DatatypeProperty ;
               rdfs:domain ts:TenderBids ;
               rdfs:range xsd:string ;
               skos:altLabel "Cible du Lot"@fr ;
               skos:definition "Indique le lot spécifique pour lequel l'entreprise dépose son offre."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Soumission pour le Lot"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Adress
ts:Has_Adress rdf:type owl:DatatypeProperty ;
              rdfs:domain ts:Contractor ;
              rdfs:range xsd:string ;
              skos:altLabel "Adresse"@fr ;
              skos:definition "Adresse physique ou siège social de l'entreprise (concurrent)."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Adresse de l'Entreprise"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau_Doc
ts:Has_Bordereau_Doc rdf:type owl:DatatypeProperty ;
                     rdfs:domain ts:Bordereaux ;
                     rdfs:range xsd:anyURI ;
                     skos:altLabel "A un BDP"@fr ;
                     skos:definition "Indique la présence logicielle ou structurelle du Bordereau des Prix."@fr ;
                     skos:inScheme ts:TenderStructureScheme ;
                     skos:prefLabel "Fichier du Bordereau"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Budget
ts:Has_Budget rdf:type owl:DatatypeProperty ;
              rdfs:domain ts:Tenders ;
              rdfs:range xsd:decimal ;
              skos:altLabel "Estimation, Montant"@fr ;
              skos:definition "Montant prévisionnel (TTC ou HT) alloué par le maître d'ouvrage pour le marché."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Estimation du Budget"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_CPS_Doc
ts:Has_CPS_Doc rdf:type owl:DatatypeProperty ;
               rdfs:domain ts:TenderSpecifications ;
               rdfs:range xsd:anyURI ;
               skos:altLabel "Fichier du Cahier des Prescriptions Spéciales"@fr ;
               skos:definition "Lien ou référence vers le document détaillé des prescriptions spéciales."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Document CPS"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Caution
ts:Has_Caution rdf:type owl:DatatypeProperty ;
               rdfs:domain ts:Tenders ;
               rdfs:range xsd:decimal ;
               skos:altLabel "Garantie de Soumission"@fr ;
               skos:definition "Montant exigé des concurrents pour garantir leur participation à l'appel d'offres."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Caution Provisoire"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Contact
ts:Has_Contact rdf:type owl:DatatypeProperty ;
               rdfs:domain ts:Contractor ;
               rdfs:range xsd:string ;
               skos:altLabel "Personne à Contacter"@fr ;
               skos:definition "Nom de la personne physique désignée comme contact principal pour l'entreprise."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Contact"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Date
ts:Has_Date rdf:type owl:DatatypeProperty ;
            rdfs:domain ts:TenderResults ;
            rdfs:range xsd:dateTime ;
            skos:altLabel "Date de Lancement"@fr ;
            skos:definition "Date officielle de publication de l'avis de l'appel d'offres en portail."@fr ;
            skos:inScheme ts:TenderStructureScheme ;
            skos:prefLabel "Date de Publication"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Deadline
ts:Has_Deadline rdf:type owl:DatatypeProperty ;
                rdfs:domain ts:Tenders ;
                rdfs:range xsd:dateTime ;
                skos:altLabel "Echéance"@fr ;
                skos:definition "Date et heure limites pour le dépôt des plis par les concurrents."@fr ;
                skos:inScheme ts:TenderStructureScheme ;
                skos:prefLabel "Date Limite de Remise"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Designation
ts:Has_Designation rdf:type owl:DatatypeProperty ;
                   rdfs:domain ts:Articles ;
                   rdfs:range xsd:string ;
                   skos:altLabel "Description de Prix"@fr ;
                   skos:definition "Libellé texte décrivant l'article de prix dans le bordereau."@fr ;
                   skos:inScheme ts:TenderStructureScheme ;
                   skos:prefLabel "Désignation de l'Article"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_ICE
ts:Has_ICE rdf:type owl:DatatypeProperty ;
           rdfs:domain ts:Contractor ;
           rdfs:range xsd:string ;
           skos:altLabel "ICE"@fr ;
           skos:definition "Numéro d'identification légale unique de l'entreprise au Maroc (15 chiffres)."@fr ;
           skos:inScheme ts:TenderStructureScheme ;
           skos:prefLabel "Identifiant Commun de l'Entreprise"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Mail
ts:Has_Mail rdf:type owl:DatatypeProperty ;
            rdfs:domain ts:Contractor ;
            rdfs:range xsd:string ;
            skos:altLabel "Courriel"@fr ;
            skos:definition "Adresse email de contact professionnel de l'entreprise ou du représentant."@fr ;
            skos:inScheme ts:TenderStructureScheme ;
            skos:prefLabel "Email"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Multilot
ts:Has_Multilot rdf:type owl:DatatypeProperty ;
                rdfs:domain ts:Tenders ;
                rdfs:range xsd:boolean ;
                skos:altLabel "Multi-lots"@fr ;
                skos:definition "Indique si le marché est divisé en plusieurs lots indépendants."@fr ;
                skos:inScheme ts:TenderStructureScheme ;
                skos:prefLabel "Marché Alloti"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Name
ts:Has_Name rdf:type owl:DatatypeProperty ;
            rdfs:domain ts:Contractor ;
            rdfs:range xsd:string ;
            skos:altLabel "Raison Sociale"@fr ;
            skos:definition "Nom légal de l'entreprise ou raison sociale sous laquelle elle est enregistrée."@fr ;
            skos:inScheme ts:TenderStructureScheme ;
            skos:prefLabel "Nom de l'Entreprise"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Object
ts:Has_Object rdf:type owl:DatatypeProperty ;
              rdfs:domain ts:Tenders ;
              rdfs:range xsd:string ;
              skos:altLabel "Titre de l'AO"@fr ;
              skos:definition "Description principale des prestations ou travaux objet du marché."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Objet de l'Appel d'Offres"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Owner
ts:Has_Owner rdf:type owl:DatatypeProperty ;
             rdfs:domain ts:Contractor ;
             rdfs:range xsd:string ;
             skos:altLabel "Dirigeant"@fr ;
             skos:definition "Nom du propriétaire, du directeur général ou du gérant légal de l'entreprise."@fr ;
             skos:inScheme ts:TenderStructureScheme ;
             skos:prefLabel "Propriétaire"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_PV
ts:Has_PV rdf:type owl:DatatypeProperty ;
          rdfs:domain ts:TenderResults ;
          rdfs:range xsd:anyURI ;
          skos:altLabel "PV d'ouverture"@fr ;
          skos:definition "Document officiel de la séance d'ouverture des plis ou d'attribution."@fr ;
          skos:inScheme ts:TenderStructureScheme ;
          skos:prefLabel "Procès-Verbal"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Phone
ts:Has_Phone rdf:type owl:DatatypeProperty ;
             rdfs:domain ts:Contractor ;
             rdfs:range xsd:string ;
             skos:altLabel "Tél"@fr ;
             skos:definition "Numéro de téléphone fixe ou mobile pour contacter l'entreprise."@fr ;
             skos:inScheme ts:TenderStructureScheme ;
             skos:prefLabel "Téléphone"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_RC_Doc
ts:Has_RC_Doc rdf:type owl:DatatypeProperty ;
              rdfs:domain ts:TenderReglement ;
              rdfs:range xsd:anyURI ;
              skos:altLabel "Fichier du Règlement de Consultation"@fr ;
              skos:definition "Lien ou référence vers le document fixant les règles de l'appel d'offres."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Document RC"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Reglement_Vector
ts:Has_Reglement_Vector rdf:type owl:DatatypeProperty ;
                        rdfs:domain ts:TenderReglement ;
                        rdfs:range xsd:string ;
                        skos:altLabel "Embedding Administratif"@fr ;
                        skos:definition "Représentation vectorielle du contenu administratif (RC) pour l'IA/recherche."@fr ;
                        skos:inScheme ts:TenderStructureScheme ;
                        skos:prefLabel "Vecteur du Règlement"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Spec_Vector
ts:Has_Spec_Vector rdf:type owl:DatatypeProperty ;
                   rdfs:domain ts:TenderSpecifications ;
                   rdfs:range xsd:string ;
                   skos:altLabel "Embedding Technique"@fr ;
                   skos:definition "Représentation vectorielle du contenu technique (CPS) pour l'IA/recherche."@fr ;
                   skos:inScheme ts:TenderStructureScheme ;
                   skos:prefLabel "Vecteur de Spécifications"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Status
ts:Has_Status rdf:type owl:DatatypeProperty ;
              rdfs:domain ts:TenderResults ;
              rdfs:range xsd:string ;
              skos:altLabel "Etat Actuel"@fr ;
              skos:definition "Phase courante (Ouvert, Attribué, Infructueux, Annulé)."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Statut du Marché"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_Unit
ts:Has_Unit rdf:type owl:DatatypeProperty ;
            rdfs:domain ts:Articles ;
            rdfs:range xsd:string ;
            skos:altLabel "Unité (U, mètre, forfait)"@fr ;
            skos:definition "Unité applicable à la quantité d'un article de prix (ex: U, ml, m2, m3, FF)."@fr ;
            skos:inScheme ts:TenderStructureScheme ;
            skos:prefLabel "Unité de Mesure"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Has_quantity
ts:Has_quantity rdf:type owl:DatatypeProperty ;
                rdfs:domain ts:Articles ;
                rdfs:range xsd:decimal ;
                skos:altLabel "Volume"@fr ;
                skos:definition "Quantité physique associée à un article spécifique du bordereau."@fr ;
                skos:inScheme ts:TenderStructureScheme ;
                skos:prefLabel "Quantité Estimée"@fr .


#################################################################
#    Classes
#################################################################

###  http://www.tenderintelligence.io/ontology/tender-structure#Architecte
ts:Architecte rdf:type owl:Class ;
              rdfs:subClassOf ts:Contractor ;
              skos:altLabel "Cabinet d'Architecture"@fr ;
              skos:broader ts:Contractor ;
              skos:definition "Professionnel chargé de la conception architecturale des ouvrages."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Architecte"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Articles
ts:Articles rdf:type owl:Class ;
            rdfs:subClassOf ts:Bordereaux ;
            skos:altLabel "Ligne BDP"@fr ;
            skos:broader ts:Bordereaux ;
            skos:definition "Une ligne spécifique de prestation ou fourniture au sein du bordereau."@fr ;
            skos:inScheme ts:TenderStructureScheme ;
            skos:prefLabel "Article de Prix"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Bordereaux
ts:Bordereaux rdf:type owl:Class ;
              rdfs:subClassOf ts:Tenders ;
              skos:altLabel "BDP"@fr ,
                            "BP"@fr ,
                            "DCE"@fr ,
                            "DQE"@fr ;
              skos:broader ts:Tenders ;
              skos:definition "Document listant les prix unitaires et forfaitaires des prestations."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Bordereau des Prix"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#BureauConsulting
ts:BureauConsulting rdf:type owl:Class ;
                    rdfs:subClassOf ts:Contractor ;
                    skos:altLabel "Conseil"@fr ;
                    skos:broader ts:Contractor ;
                    skos:definition "Entité fournissant des prestations intellectuelles et stratégiques."@fr ;
                    skos:inScheme ts:TenderStructureScheme ;
                    skos:prefLabel "Cabinet de Conseil"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#BureauEtude
ts:BureauEtude rdf:type owl:Class ;
               rdfs:subClassOf ts:Contractor ;
               skos:altLabel "BET"@fr ;
               skos:broader ts:Contractor ;
               skos:definition "Structure d'ingénierie et de conseil technique."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Bureau d'Études"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Buyers
ts:Buyers rdf:type owl:Class ;
          skos:altLabel "Maître d'ouvrage"@fr ;
          skos:definition "Entité publique (ministère, établissement public, etc.) lançant l'appel d'offres."@fr ;
          skos:inScheme ts:TenderStructureScheme ;
          skos:prefLabel "Acheteur Public"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Contractor
ts:Contractor rdf:type owl:Class ;
              skos:altLabel "Concurrent"@fr ,
                            "Société"@fr ;
              skos:definition "Entité économique soumissionnant ou exécutant le marché public."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Entrepreneur"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#EntrepriseServices
ts:EntrepriseServices rdf:type owl:Class ;
                      rdfs:subClassOf ts:Contractor ;
                      skos:altLabel "Prestataire"@fr ;
                      skos:broader ts:Contractor ;
                      skos:definition "Société fournissant des services d'entretien, IT, ou logistique."@fr ;
                      skos:inScheme ts:TenderStructureScheme ;
                      skos:prefLabel "Entreprise de Services"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#EntrepriseTravaux
ts:EntrepriseTravaux rdf:type owl:Class ;
                     rdfs:subClassOf ts:Contractor ;
                     skos:altLabel "BTP"@fr ,
                                   "GC"@fr ;
                     skos:broader ts:Contractor ;
                     skos:definition "Entreprise réalisant des travaux de construction et BTP."@fr ;
                     skos:inScheme ts:TenderStructureScheme ;
                     skos:prefLabel "Entreprise de Travaux"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Fournisseur
ts:Fournisseur rdf:type owl:Class ;
               rdfs:subClassOf ts:Contractor ;
               skos:altLabel "Vendor"@fr ;
               skos:broader ts:Contractor ;
               skos:definition "Entité fournissant des biens et matériels."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Fournisseur"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#InExecution
ts:InExecution rdf:type owl:Class ;
               rdfs:subClassOf ts:TenderExecution ;
               skos:altLabel "En cours"@fr ;
               skos:broader ts:TenderExecution ;
               skos:definition "Le marché est actuellement en cours d'exécution par le titulaire."@fr ;
               skos:inScheme ts:TenderStructureScheme ;
               skos:prefLabel "Marché en Cours d'Exécution"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#TenderBids
ts:TenderBids rdf:type owl:Class ;
              owl:disjointWith ts:TenderResults ;
              skos:altLabel "Soumission"@fr ;
              skos:broader ts:TendersComission ;
              skos:definition "Offre technique et financière déposée par un soumissionnaire."@fr ;
              skos:inScheme ts:TenderStructureScheme ;
              skos:prefLabel "Offre Concurrent"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#TenderExecuted
ts:TenderExecuted rdf:type owl:Class ;
                  rdfs:subClassOf ts:TenderExecution ;
                  skos:altLabel "Réceptionné"@fr ;
                  skos:broader ts:TenderExecution ;
                  skos:definition "Le marché a été entièrement exécuté et réceptionné par le maître d'ouvrage."@fr ;
                  skos:inScheme ts:TenderStructureScheme ;
                  skos:prefLabel "Marché Exécuté"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#TenderExecution
ts:TenderExecution rdf:type owl:Class .


###  http://www.tenderintelligence.io/ontology/tender-structure#TenderInfructeux
ts:TenderInfructeux rdf:type owl:Class ;
                    skos:altLabel "AO sans suite"@fr ;
                    skos:definition "Appel d'offres déclaré infructueux faute d'offres valides ou conformes."@fr ;
                    skos:inScheme ts:TenderStructureScheme ;
                    skos:prefLabel "Marché Infructueux"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#TenderReglement
ts:TenderReglement rdf:type owl:Class ;
                   rdfs:subClassOf ts:Tenders ;
                   skos:altLabel "RC"@fr ;
                   skos:broader ts:Tenders ;
                   skos:definition "Document fixant les règles de la consultation pour les concurrents."@fr ;
                   skos:inScheme ts:TenderStructureScheme ;
                   skos:prefLabel "Règlement de Consultation"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#TenderResilied
ts:TenderResilied rdf:type owl:Class ;
                  rdfs:subClassOf ts:TenderExecution ;
                  skos:altLabel "Annulé"@fr ;
                  skos:broader ts:TenderExecution ;
                  skos:definition "Le marché a été interrompu prématurément suite à une résiliation."@fr ;
                  skos:inScheme ts:TenderStructureScheme ;
                  skos:prefLabel "Marché Résilié"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#TenderResults
ts:TenderResults rdf:type owl:Class ;
                 skos:altLabel "Décision du Jury"@fr ;
                 skos:definition "Rapport final détaillant les concurrents retenus et écartés."@fr ;
                 skos:inScheme ts:TenderStructureScheme ;
                 skos:prefLabel "Résultat d'Appel d'Offres"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#TenderSpecifications
ts:TenderSpecifications rdf:type owl:Class ;
                        rdfs:subClassOf ts:Tenders ;
                        skos:altLabel "CPS"@fr ,
                                      "Specs"@fr ;
                        skos:broader ts:Tenders ;
                        skos:definition "Document fixant les clauses techniques et administratives du marché."@fr ;
                        skos:inScheme ts:TenderStructureScheme ;
                        skos:prefLabel "Cahier des Prescriptions Spéciales"@fr .


###  http://www.tenderintelligence.io/ontology/tender-structure#Tenders
ts:Tenders rdf:type owl:Class ;
           skos:altLabel "AO"@fr ,
                         "Marché Public"@fr ;
           skos:definition "Procédure de passation pour attributer un marché public."@fr ;
           skos:inScheme ts:TenderStructureScheme ;
           skos:prefLabel "Appel d'Offres"@fr .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class .


