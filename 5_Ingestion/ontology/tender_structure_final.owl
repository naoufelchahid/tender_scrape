        <skos:altLabel xml:lang="fr">Multi-lots</skos:altLabel>
        <skos:definition xml:lang="fr">Indique si l&apos;AO est décomposé en plusieurs lots (true) ou non (false).</skos:definition>
        <skos:definition xml:lang="fr">Indique si le marché est divisé en plusieurs lots indépendants.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est multi-lots</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Marché Alloti</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Name -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Name">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
