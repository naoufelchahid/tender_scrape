<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.tenderintelligence.io/ontology/tender-structure#"
     xml:base="http://www.tenderintelligence.io/ontology/tender-structure"
     xmlns:ts="http://www.tenderintelligence.io/ontology/tender-structure#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:qualif="http://www.tenderintelligence.io/ontology/qualification#"
     xmlns:activity="http://www.tenderintelligence.io/ontology/activity-domains#">
    <owl:Ontology rdf:about="http://www.tenderintelligence.io/ontology/tender-structure"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.tenderintelligence.io/ontology/activity-domains#code -->

    <owl:AnnotationProperty rdf:about="http://www.tenderintelligence.io/ontology/activity-domains#code"/>
    


    <!-- http://www.tenderintelligence.io/ontology/qualification#code -->

    <owl:AnnotationProperty rdf:about="http://www.tenderintelligence.io/ontology/qualification#code"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broaderTransitive -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broaderTransitive"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#hasTopConcept -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#hasTopConcept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#hiddenLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#hiddenLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#narrower -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#narrower"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#narrowerTransitive -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#narrowerTransitive"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#notation -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#notation"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#topConceptOf -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#topConceptOf"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Executes -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#Executes">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#InExecution"/>
        <skos:altLabel xml:lang="fr">En cours d&apos;exécution</skos:altLabel>
        <skos:definition xml:lang="fr">Indique que l&apos;entrepreneur est actuellement en train d&apos;exécuter le marché.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Exécute</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Has_Execution -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#Has_Execution">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderExecution"/>
        <skos:altLabel xml:lang="fr">Suivi d&apos;exécution</skos:altLabel>
        <skos:definition xml:lang="fr">Lie le résultat de l&apos;appel d&apos;offres à son état ou phase d&apos;exécution.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A pour phase d&apos;exécution</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Has_executed -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#Has_executed">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderExecuted"/>
        <skos:altLabel xml:lang="fr">Marché achevé</skos:altLabel>
        <skos:definition xml:lang="fr">Indique que l&apos;entrepreneur a complètement exécuté et achevé le marché.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A exécuté</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Has_resilied -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#Has_resilied">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResilied"/>
        <skos:altLabel xml:lang="fr">Marché annulé</skos:altLabel>
        <skos:definition xml:lang="fr">Indique que le marché confié à l&apos;entrepreneur a été résilié avant son terme.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A été résilié</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Is_Executed -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#Is_Executed">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderExecuted"/>
        <skos:altLabel xml:lang="fr">Achevé</skos:altLabel>
        <skos:definition xml:lang="fr">Indique que le marché issu de ce résultat a été entièrement exécuté.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est exécuté</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Is_The_Unit_Price_for -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#Is_The_Unit_Price_for">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Articles"/>
        <skos:altLabel xml:lang="fr">Prix de l&apos;article soumissionné</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;offre globale (soumission) aux prix unitaires proposés pour chaque article.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est le prix unitaire pour</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Is_infructueux -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#Is_infructueux">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderInfructeux"/>
        <skos:altLabel xml:lang="fr">Sans suite</skos:altLabel>
        <skos:definition xml:lang="fr">Indique que le résultat de l&apos;appel d&apos;offres a été déclaré infructueux.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est infructueux</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Is_resilied -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#Is_resilied">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResilied"/>
        <skos:altLabel xml:lang="fr">Annulé</skos:altLabel>
        <skos:definition xml:lang="fr">Indique que le marché issu de ce résultat a été résilié.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est résilié</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Buyer_Operates_In_Region -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Buyer_Operates_In_Region">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Launched"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Located_In"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Rayonnement géographique</skos:altLabel>
        <skos:altLabel xml:lang="fr">Zone de passation</skos:altLabel>
        <skos:definition xml:lang="fr">Région(s) administrative(s) marocaine(s) dans lesquelles un acheteur public publie ses appels d&apos;offres. Inférée via Launched ∘ Is_Located_In.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Lance des AO dans la région</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Buys_In_Category -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Buys_In_Category">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Launched"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Category"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Catégorie de marché achetée</skos:altLabel>
        <skos:altLabel xml:lang="fr">Domaine d&apos;achat public</skos:altLabel>
        <skos:definition xml:lang="fr">Catégorie(s) de marché (Travaux, Fournitures, Services) dans lesquelles un acheteur public lance des appels d&apos;offres. Inférée via Launched ∘ Has_Category.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Achète dans la catégorie</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Co_Bidder_In_Region -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Co_Bidder_In_Region">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Competes_In_Region"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Competes_In_Region"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Concurrent régional</skos:altLabel>
        <skos:altLabel xml:lang="fr">Pair géographique de marché</skos:altLabel>
        <skos:definition xml:lang="fr">Lie deux entrepreneurs qui ont tous deux soumissionné dans la même région, constituant ainsi leurs pairs sur le marché géographique local. Propriété symétrique, inférée via Competes_In_Region ∘ ⁻Competes_In_Region.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est co-soumissionnaire régional de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Competes_In_Region -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Competes_In_Region">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_in"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Proces_Verbal_of"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Located_In"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Région de soumission</skos:altLabel>
        <skos:altLabel xml:lang="fr">Territoire d&apos;activité</skos:altLabel>
        <skos:definition xml:lang="fr">Région(s) administrative(s) marocaine(s) où un entrepreneur a déposé des offres (gagnées ou non). Indique son territoire de prospection. Inférée via Formulate_Bid ∘ Is_Bid_in ∘ Is_Proces_Verbal_of ∘ Is_Located_In.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Prospecte la région</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <skos:altLabel xml:lang="fr">Soumet</skos:altLabel>
        <skos:definition xml:lang="fr">Lie le Concurrent (Entrepreneur) à l&apos;Offre (Soumission) qu&apos;il a préparée.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A formulé l&apos;offre</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Article -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Article">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Bordereaux"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Articles"/>
        <skos:altLabel xml:lang="fr">Comprend l&apos;article</skos:altLabel>
        <skos:definition xml:lang="fr">Lie le Bordereau des Prix à ses articles ou lignes de prestations spécifiques.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Contient une ligne de prix</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Article_Category -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Article_Category">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Articles"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:altLabel xml:lang="fr">Spécialité de l&apos;article</skos:altLabel>
        <skos:definition xml:lang="fr">Lie un article du bordereau à un concept SKOS précis dans le schéma du domaine d&apos;activité de l&apos;appel d&apos;offres parent (ex : activity:TravauxDelectricite pour un article d&apos;électricité). Le concept cible doit appartenir au même skos:ConceptScheme que la catégorie du marché.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A pour sous-catégorie d&apos;article</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Bid -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Bid">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <skos:altLabel xml:lang="fr">Offres déposées</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse; lie l&apos;Appel d&apos;Offres aux offres concurrentes déposées.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A reçu comme Offre</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Bordereaux"/>
        <skos:altLabel xml:lang="fr">Inclut le Bordereau</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;Appel d&apos;Offres ou le CPS au Bordereau des Prix (BDP).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Contient un BDP</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Category -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Category">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <skos:altLabel xml:lang="fr">Domaine d&apos;activité</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;appel d&apos;offres à son domaine d&apos;activité principal (Travaux, Fournitures ou Services) selon la nomenclature marocaine des marchés publics. Pointe vers l&apos;un des trois concepts racines : activity:Travaux, activity:Fournitures ou activity:Services.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A pour catégorie</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Chunk -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Chunk">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderReglement"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderSpecifications"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderSpecifications"/>
        <rdfs:label xml:lang="fr">A pour chunk</rdfs:label>
        <skos:definition xml:lang="fr">Lie le nœud parent (CPS ou RC) à un nœud chunk individuel. Chaque chunk représente un fragment sémantique identifié par son en-tête H3.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Contient le chunk</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Client -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Client">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Launched_by"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Donneur d&apos;ordre</skos:altLabel>
        <skos:altLabel xml:lang="fr">Maître d&apos;ouvrage client</skos:altLabel>
        <skos:definition xml:lang="fr">Lie un entrepreneur à chaque acheteur public qui lui a attribué un marché. Inférée via la chaîne ⁻IsAwarded_to ∘ Launched_by.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A pour Client</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Competed_In -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Competed_In">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_in"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Proces_Verbal_of"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">A soumissionné pour</skos:altLabel>
        <skos:altLabel xml:lang="fr">Participation AO</skos:altLabel>
        <skos:definition xml:lang="fr">Lie un entrepreneur à tous les appels d&apos;offres auxquels il a participé (gagnés ou perdus). Inférée via la chaîne Formulate_Bid ∘ Is_Bid_in ∘ Is_Proces_Verbal_of.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A participé à</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Execution_Status -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Execution_Status">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderExecution"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Opened"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#Has_Execution"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Etat d&apos;avancement</skos:altLabel>
        <skos:altLabel xml:lang="fr">Phase d&apos;exécution en cours</skos:altLabel>
        <skos:definition xml:lang="fr">Lie un entrepreneur à la phase d&apos;exécution (en cours, exécuté, résilié) des marchés qui lui sont attribués. Inférée via ⁻IsAwarded_to ∘ Is_Opened ∘ ⁻Has_Execution.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A pour statut d&apos;exécution</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Hired -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Hired">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Launched"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Attributions contractuelles</skos:altLabel>
        <skos:altLabel xml:lang="fr">Prestataires engagés</skos:altLabel>
        <skos:definition xml:lang="fr">Lie un acheteur public à tous les entrepreneurs auxquels il a attribué des marchés. Relation inverse de Has_Client, inférée via Launched ∘ IsAwarded_to.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A contractualisé avec</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Lost_To -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Lost_To">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Competitor"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Battu par</skos:altLabel>
        <skos:altLabel xml:lang="fr">Évincé par</skos:altLabel>
        <skos:definition xml:lang="fr">Lie un entrepreneur à ses concurrents qui ont remporté un marché face à lui. Inférée via Is_Competitor ∘ ⁻IsAwarded_to ∘ IsAwarded_to.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A perdu face à</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Participant -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Participant">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Opened"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_of"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Concurrents présents</skos:altLabel>
        <skos:altLabel xml:lang="fr">Soumissionnaires</skos:altLabel>
        <skos:definition xml:lang="fr">Tous les entrepreneurs ayant déposé une offre pour cet appel d&apos;offres, qu&apos;elle soit retenue ou écartée. Inférée via Is_Opened ∘ Has_Bid ∘ Is_Bid_of.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A pour participant</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Phase_Interval -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Phase_Interval">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderTimeline"/>
        <skos:altLabel xml:lang="fr">Phase temporelle</skos:altLabel>
        <skos:definition xml:lang="fr">Relie un TenderTimeline à un intervalle temporel de phase spécifique (soumission, évaluation, exécution).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Contient l&apos;Intervalle de Phase</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Reglement_Consultation -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Reglement_Consultation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderReglement"/>
        <skos:altLabel xml:lang="fr">A pour Règlement</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;appel d&apos;offres au document fixant les règles de la consultation (RC).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est régi par le RC</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Rejected_Bidder -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Rejected_Bidder">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Opened"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Rejected_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_of"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Non retenus</skos:altLabel>
        <skos:altLabel xml:lang="fr">Offres écartées de</skos:altLabel>
        <skos:definition xml:lang="fr">Entrepreneurs dont les offres ont été formellement rejetées lors de l&apos;évaluation de cet AO. Inférée via Is_Opened ∘ Rejected_Bid ∘ Is_Bid_of.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A écarté le concurrent</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Rejected_Contractor -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Rejected_Contractor">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Launched"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Opened"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Rejected_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_of"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Offre rejetée de</skos:altLabel>
        <skos:altLabel xml:lang="fr">Soumissionnaire écarté</skos:altLabel>
        <skos:definition xml:lang="fr">Entrepreneurs dont les offres ont été rejetées lors d&apos;au moins un AO lancé par cet acheteur. Inférée via Launched ∘ Is_Opened ∘ Rejected_Bid ∘ Is_Bid_of.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A rejeté la candidature de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Timeline -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Timeline">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderTimeline"/>
        <skos:altLabel xml:lang="fr">Timeline du marché</skos:altLabel>
        <skos:definition xml:lang="fr">Lie un appel d&apos;offres à l&apos;objet TenderTimeline qui agrège ses intervalles de phase.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A pour Chronologie</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Won -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Won">
        <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <skos:altLabel xml:lang="fr">Adjudications</skos:altLabel>
        <skos:altLabel xml:lang="fr">Marchés remportés</skos:altLabel>
        <skos:definition xml:lang="fr">Raccourci nommé reliant directement un entrepreneur à tous les appels d&apos;offres qu&apos;il a remportés. Propriété inverse de ts:IsAwarded_to.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A remporté</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_lot -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_lot">
        <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Is_lot_of"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Lots"/>
        <rdfs:label xml:lang="fr">A pour lot</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_specifications -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_specifications">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderSpecifications"/>
        <skos:altLabel xml:lang="fr">Régi par le CPS</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;appel d&apos;offres au Cahier des Prescriptions Spéciales (CPS).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Contient les spécifications CPS</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Includes_Article_Category -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Includes_Article_Category">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Article"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Article_Category"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Sous-catégorie de prestation</skos:altLabel>
        <skos:altLabel xml:lang="fr">Spécialité technique BDP</skos:altLabel>
        <skos:definition xml:lang="fr">Relie directement un appel d&apos;offres aux concepts SKOS granulaires des articles de son bordereau des prix, permettant la recherche sémantique par spécialité. Inférée via Has_Bordereau ∘ Has_Article ∘ Has_Article_Category.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Requiert la sous-spécialité</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Opened"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Winner_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_of"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Adjugé à</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;Appel d&apos;Offres au Concurrent (Entrepreneur) retenu comme attributaire. Inférée via la chaîne Is_Opened ∘ Is_Winner_Bid ∘ Is_Bid_of.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est attribué à</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Article_of -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Article_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Articles"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Bordereaux"/>
        <skos:altLabel xml:lang="fr">Ligne du Bordereau</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse; connecte un article de prix au Bordereau des Prix parent.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Fait partie du BDP</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_in -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_in">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <skos:altLabel xml:lang="fr">Offre déposée pour</skos:altLabel>
        <skos:definition xml:lang="fr">Lie une Offre (Soumission) à l&apos;Appel d&apos;Offres ou Lot correspondant.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A été soumissionnée pour</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_of -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <skos:altLabel xml:lang="fr">Soumis par</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse; lie l&apos;Offre à l&apos;Entrepreneur (Concurrent) qui l&apos;a déposée.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est l&apos;offre de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Bordereau_of -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bordereau_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Bordereaux"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <skos:altLabel xml:lang="fr">BDP rattaché à</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse; lie le Bordereau des Prix à l&apos;appel d&apos;offres correspondant.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est le BDP de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Competitor -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Competitor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_in"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_of"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Concurrent de</skos:altLabel>
        <skos:altLabel xml:lang="fr">En compétition avec</skos:altLabel>
        <skos:definition xml:lang="fr">Lie deux entrepreneurs ayant soumissionné sur le même appel d&apos;offres. Propriété réflexive (tout entrepreneur est son propre concurrent) et symétrique (si A est concurrent de B, B est concurrent de A). Inférée automatiquement via la chaîne Formulate_Bid ∘ ⁻Formulate_Bid.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est concurrent de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Located_In -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Located_In">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:altLabel xml:lang="fr">Région de l&apos;AO</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;appel d&apos;offres à la région administrative marocaine dans laquelle il est publié ou exécuté. La valeur cible est un individu du schéma regions:MoroccoRegionsScheme (ex : regions:CasablancaSettat).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est situé dans</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Opened -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Opened">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <skos:altLabel xml:lang="fr">Plis ouverts (PV)</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;Appel d&apos;Offres au Procès-Verbal d&apos;ouverture des plis.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A été ouvert lors du PV</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Partner -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Partner">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Associé de</skos:altLabel>
        <skos:altLabel xml:lang="fr">Groupement avec</skos:altLabel>
        <skos:definition xml:lang="fr">Lie deux entrepreneurs ayant soumissionné conjointement sur la même instance de TenderBids (offre groupée / consortium). Propriété symétrique, inférée via la chaîne Formulate_Bid ∘ ⁻Formulate_Bid sur une même offre partagée.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est partenaire de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Proces_Verbal_of -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Proces_Verbal_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <skos:altLabel xml:lang="fr">PV relatif à l&apos;AO</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse; lie le Procès-Verbal à l&apos;Appel d&apos;Offres concerné.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est le PV d&apos;ouverture de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Reglement_Consultation_Of -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Reglement_Consultation_Of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderReglement"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <skos:altLabel xml:lang="fr">Régit l&apos;AO</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse; lie le Règlement de Consultation à son Appel d&apos;Offres.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est le RC de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Rejected_Bid -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Rejected_Bid">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <skos:altLabel xml:lang="fr">Rejeté pour l&apos;AO</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse; indique qu&apos;une offre spécifique a été rejetée pour un AO donné.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est une offre écartée de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_Winner_Bid -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Winner_Bid">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <skos:altLabel xml:lang="fr">Soumission gagnante</skos:altLabel>
        <skos:definition xml:lang="fr">Indique que l&apos;offre a été retenue et a remporté l&apos;Appel d&apos;Offres.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est l&apos;offre retenue pour</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_lot_of -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_lot_of">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Lots"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:label xml:lang="fr">Est le lot de</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Is_specifications_of -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_specifications_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderSpecifications"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <skos:altLabel xml:lang="fr">Spécifie l&apos;AO</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse; lie le Cahier des Prescriptions Spéciales à son Appel d&apos;Offres.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est le CPS de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Launched -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Launched">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <skos:altLabel xml:lang="fr">Est l&apos;initiateur de</skos:altLabel>
        <skos:definition xml:lang="fr">Relation inverse de :Launched_by; connecte l&apos;Acheteur à ses Appels d&apos;Offres.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A lancé</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Launched_by -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Launched_by">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <skos:altLabel xml:lang="fr">Initié par</skos:altLabel>
        <skos:definition xml:lang="fr">Indique l&apos;Acheteur (Maître d&apos;Ouvrage) responsable du lancement de l&apos;appel d&apos;offres.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Lancé par</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Operates_In_Category -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Operates_In_Category">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Formulate_Bid"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Bid_in"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Proces_Verbal_of"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Category"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Domaine marché</skos:altLabel>
        <skos:altLabel xml:lang="fr">Secteur d&apos;activité déclaré</skos:altLabel>
        <skos:definition xml:lang="fr">Catégorie(s) de haut niveau (Travaux, Fournitures, Services) dans lesquelles un entrepreneur a soumissionné. Inférée via Formulate_Bid ∘ Is_Bid_in ∘ Is_Proces_Verbal_of ∘ Has_Category.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Opère dans la catégorie</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Provides_Service_Category -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Provides_Service_Category">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Supply"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Article_Category"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Compétence prouvée</skos:altLabel>
        <skos:altLabel xml:lang="fr">Sous-domaine réalisé</skos:altLabel>
        <skos:definition xml:lang="fr">Concept SKOS granulaire (sous-domaine d&apos;activité) que l&apos;entrepreneur a démontré sa capacité à livrer, déduit des articles des marchés qui lui ont été attribués. Inférée via Supply ∘ Has_Article_Category.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Maîtrise la sous-catégorie</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Rejected_Bid -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Rejected_Bid">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <skos:altLabel xml:lang="fr">Offre écartée</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;Appel d&apos;Offres (via le jury) à une offre qui a été écartée lors de l&apos;évaluation.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">A rejeté l&apos;offre</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Same_Region_Tender -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Same_Region_Tender">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Located_In"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Is_Located_In"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">AO de la même région</skos:altLabel>
        <skos:altLabel xml:lang="fr">Marché régional similaire</skos:altLabel>
        <skos:definition xml:lang="fr">Relie deux appels d&apos;offres publiés dans la même région marocaine. Propriété symétrique permettant le clustering géographique de marchés. Inférée via Is_Located_In ∘ ⁻Is_Located_In.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Est dans la même région que</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Serve_Region -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Serve_Region">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Is_Located_In"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Zone d&apos;intervention</skos:altLabel>
        <skos:definition xml:lang="fr">Région administrative marocaine dans laquelle un prestataire opère, inférée automatiquement : si un appel d&apos;offres est situé dans une région (ts:Is_Located_In) et qu&apos;un prestataire remporte cet appel (ts:Is_Awarded_To), alors ce prestataire sert cette région via ts:Serve_Region.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Intervient dans la région</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Supply -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Supply">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Articles"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#IsAwarded_to"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau"/>
            <rdf:Description rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Article"/>
        </owl:propertyChainAxiom>
        <skos:altLabel xml:lang="fr">Fournit</skos:altLabel>
        <skos:altLabel xml:lang="fr">Réalise</skos:altLabel>
        <skos:definition xml:lang="fr">Lie l&apos;entrepreneur attributaire aux articles (prestations / fournitures) du bordereau du marché qui lui a été attribué. Inférée via la chaîne ⁻IsAwarded_to ∘ Has_Bordereau ∘ Has_Article.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Fournit l&apos;Article</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#buyer -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#buyer">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyer"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#city -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#city">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#consultation_type -->

    <owl:ObjectProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#consultation_type">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Lots"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Article_Bid -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Article_Bid">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:altLabel xml:lang="fr">Prix Soumissionné</skos:altLabel>
        <skos:definition xml:lang="fr">Prix unitaire proposé pour un article spécifique par le concurrent.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Prix Unitaire Proposé</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Bid_Amount -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Bid_Amount">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:altLabel xml:lang="fr">Proposition Financière</skos:altLabel>
        <skos:definition xml:lang="fr">Montant global proposé par le soumissionnaire (entreprise).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Montant de l&apos;Offre</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Bid_For_Lot -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Bid_For_Lot">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderBids"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="fr">Cible du Lot</skos:altLabel>
        <skos:definition xml:lang="fr">Indique le lot spécifique pour lequel l&apos;entreprise dépose son offre.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Soumission pour le Lot</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Adjudication_Date -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Adjudication_Date">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:altLabel xml:lang="fr">Date d&apos;Attribution</skos:altLabel>
        <skos:definition xml:lang="fr">Date à laquelle la commission a statué sur l&apos;attribution du marché.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Date d&apos;Adjudication</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Adress -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Adress">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="fr">Adresse</skos:altLabel>
        <skos:definition xml:lang="fr">Adresse physique ou siège social de l&apos;entreprise (concurrent).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Adresse de l&apos;Entreprise</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau_Content -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau_Content">
