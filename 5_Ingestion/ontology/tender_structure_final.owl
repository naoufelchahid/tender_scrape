        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="fr">Contenu textuel du bordereau</rdfs:label>
        <skos:definition xml:lang="fr">Texte brut du bordereau des prix unitaires extrait du document source.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Contenu du bordereau</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau_Doc -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Bordereau_Doc">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Bordereaux"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <skos:altLabel xml:lang="fr">A un BDP</skos:altLabel>
