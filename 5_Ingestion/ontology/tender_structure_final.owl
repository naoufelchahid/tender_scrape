        <skos:definition xml:lang="fr">Date de réception définitive ou d&apos;achèvement du marché.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Date de Fin d&apos;Exécution</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Execution_Start_Date -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Execution_Start_Date">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderExecution"/>
