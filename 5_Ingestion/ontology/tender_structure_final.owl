        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Fichier du Bordereau</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Budget -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Budget">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
