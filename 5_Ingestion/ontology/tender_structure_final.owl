        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Nom de l&apos;Entreprise</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Object -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Object">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="fr">Titre de l&apos;AO</skos:altLabel>
