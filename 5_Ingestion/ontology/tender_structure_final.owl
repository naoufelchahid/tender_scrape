        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Document CPS</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Caution -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Caution">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:altLabel xml:lang="fr">Garantie de Soumission</skos:altLabel>
        <skos:definition xml:lang="fr">Montant exigé des concurrents pour garantir leur participation à l&apos;appel d&apos;offres.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Caution Provisoire</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Chunk_Identifier -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Chunk_Identifier">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderReglement"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderSpecifications"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="fr">Identifiant du chunk (en-tête H3)</rdfs:label>
        <skos:definition xml:lang="fr">Texte de l&apos;en-tête H3 utilisé comme identifiant sémantique du chunk.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Identifiant du chunk</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Chunk_Vector_Ref -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Chunk_Vector_Ref">
