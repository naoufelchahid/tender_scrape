        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:altLabel xml:lang="fr">Date de Lancement</skos:altLabel>
        <skos:definition xml:lang="fr">Date officielle de publication de l&apos;avis de l&apos;appel d&apos;offres en portail.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Date de Publication</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Deadline -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Deadline">
