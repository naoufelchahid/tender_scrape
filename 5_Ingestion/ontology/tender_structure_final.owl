        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Objet de l&apos;Appel d&apos;Offres</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Original_Reference -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Original_Reference">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="fr">Référence originale</rdfs:label>
        <skos:definition xml:lang="fr">Référence originale du tender avant la génération de la clé composite.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Référence originale</skos:prefLabel>
    </owl:DatatypeProperty>
    


