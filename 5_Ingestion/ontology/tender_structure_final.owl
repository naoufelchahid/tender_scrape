        <skos:altLabel xml:lang="fr">Description de Prix</skos:altLabel>
        <skos:definition xml:lang="fr">Libellé texte décrivant l&apos;article de prix dans le bordereau.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Désignation de l&apos;Article</skos:prefLabel>
    </owl:DatatypeProperty>
    


