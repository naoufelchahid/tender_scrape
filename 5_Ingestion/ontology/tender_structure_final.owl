        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderSpecifications"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="fr">Référence vecteur du chunk</rdfs:label>
        <skos:definition xml:lang="fr">URI S3 de l&apos;embedding vectoriel associé à ce chunk.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Référence vecteur chunk</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_City -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_City">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="fr">Ville</rdfs:label>
        <skos:definition xml:lang="fr">Ville où le tender est situé.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Ville</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Contact -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Contact">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Buyers"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="fr">Personne à Contacter</skos:altLabel>
        <skos:definition xml:lang="fr">Nom de la personne physique désignée comme contact principal pour l&apos;entreprise.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Contact</skos:prefLabel>
    </owl:DatatypeProperty>
    


