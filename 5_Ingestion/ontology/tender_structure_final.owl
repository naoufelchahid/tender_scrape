        <skos:definition xml:lang="fr">Date et heure limites pour le dépôt des plis par les concurrents.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Date Limite de Remise</skos:prefLabel>
    </owl:DatatypeProperty>
    


