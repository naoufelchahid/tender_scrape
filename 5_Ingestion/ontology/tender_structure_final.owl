    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Owner">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Contractor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:altLabel xml:lang="fr">Dirigeant</skos:altLabel>
        <skos:definition xml:lang="fr">Nom du propriétaire, du directeur général ou du gérant légal de l&apos;entreprise.</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Propriétaire</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_PV -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_PV">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderResults"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
