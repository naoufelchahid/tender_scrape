        <rdfs:label xml:lang="fr">Mode de passation</rdfs:label>
        <skos:definition xml:lang="fr">Mode de passation du marché (ex : appel d&apos;offres ouvert, concours, bon de commande).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Mode de passation</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.tenderintelligence.io/ontology/tender-structure#Has_Mode_Soumission -->

    <owl:DatatypeProperty rdf:about="http://www.tenderintelligence.io/ontology/tender-structure#Has_Mode_Soumission">
        <rdfs:domain rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#Tenders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="fr">Mode de soumission</rdfs:label>
        <skos:definition xml:lang="fr">Mode de soumission des offres (ex : électronique, papier, hybride).</skos:definition>
        <skos:inScheme rdf:resource="http://www.tenderintelligence.io/ontology/tender-structure#TenderStructureScheme"/>
        <skos:prefLabel xml:lang="fr">Mode de soumission</skos:prefLabel>
    </owl:DatatypeProperty>
    


