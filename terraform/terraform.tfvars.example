# AWS Configuration
aws_region  = "eu-west-3"
environment = "dev"
project_name = "tender-scraper"

# S3 Bucket Configuration
s3_bucket_name         = "my-tender-documents-bucket"  # Must be globally unique
s3_versioning_enabled  = true

# PostgreSQL RDS Configuration
db_name                     = "tendersdb"
db_username                 = "admin"
db_password                 = "CHANGE_ME_STRONG_PASSWORD"  # Must be at least 8 characters
db_instance_class           = "db.t3.micro"  # Free tier eligible
db_allocated_storage        = 20             # GB
db_engine_version           = "16.3"
db_publicly_accessible      = false          # Set to true if accessing from outside AWS
db_backup_retention_period  = 7              # Days
db_skip_final_snapshot      = false          # Set to true for dev environments
