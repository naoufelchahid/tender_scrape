# Example 1: List all classes
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?class
WHERE {
  ?s rdf:type ?class .
}

# Example 2: Find tenders by budget range
PREFIX ts: <http://www.tenderintelligence.io/ontology/tender-structure#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?tender ?budget
WHERE {
  ?tender a ts:Tenders ;
          ts:Budget ?budget .
  FILTER(?budget > 100000 && ?budget < 500000)
}

# Example 3: Get all properties of a specific tender
DESCRIBE <http://www.tenderintelligence.io/ontology/tender-structure#Tender_001>
