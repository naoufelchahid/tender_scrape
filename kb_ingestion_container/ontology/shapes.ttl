# Stage: KB Ingestion — SHACL Validation Layer
# Architecture: Ontology Validation (pre-Neptune ingestion)
# Description: SHACL NodeShapes and SPARQLConstraints for tender_structure.ttl
#              Validate all instances before bulk-loading to AWS Neptune.
# Validate: pyshacl -s ontology/shapes.ttl -sg ontology/shapes.ttl ontology/tender_structure.ttl

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix ts:       <http://www.tenderintelligence.io/ontology/tender-structure#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix regions:  <http://www.tenderintelligence.io/ontology/morocco-regions#> .
@prefix activity: <http://www.tenderintelligence.io/ontology/activity-domains#> .
@prefix ont:      <http://www.co-ode.org/ontologies/ont.owl#> .


#################################################################
#  ①  ts:Tenders — NodeShape
#################################################################

ts:TendersShape
    a sh:NodeShape ;
    sh:targetClass ts:Tenders ;
    sh:name "TendersShape"@en ;
    sh:description "Contraintes sur chaque instance d'Appel d'Offres."@fr ;

    # ── IDENTITY & DESCRIPTION ──────────────────────────────────────────
    sh:property [
        sh:path ts:Has_Object ;
        sh:name "Objet de l'AO" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 10 ;
        sh:maxLength 500 ;
        sh:severity sh:Violation ;
        sh:message "L'appel d'offres doit avoir un objet (10–500 caractères)."@fr ;
    ] ;

    # ── FINANCIAL ───────────────────────────────────────────────────────
    sh:property [
        sh:path ts:Has_Budget ;
        sh:name "Budget Estimatif" ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:severity sh:Warning ;
        sh:message "Le budget estimatif ne peut pas être négatif."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_Caution ;
        sh:name "Caution Provisoire" ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:severity sh:Warning ;
        sh:message "La caution provisoire ne peut pas être négative."@fr ;
    ] ;

    # ── TEMPORAL ────────────────────────────────────────────────────────
    sh:property [
        sh:path ts:Has_Deadline ;
        sh:name "Date Limite de Remise" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "La date limite de remise des plis est obligatoire."@fr ;
    ] ;

    # ── FLAGS ───────────────────────────────────────────────────────────
    sh:property [
        sh:path ts:Has_Multilot ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:severity sh:Violation ;
        sh:message "Has_Multilot doit être un booléen (true/false)."@fr ;
    ] ;

    # ── REQUIRED OBJECT PROPERTIES ──────────────────────────────────────
    sh:property [
        sh:path ts:Launched_by ;
        sh:name "Maître d'Ouvrage" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:Buyers ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque AO doit être lancé par exactement un acheteur public (ts:Buyers)."@fr ;
    ] ;
    sh:property [
        sh:path ts:Is_Located_In ;
        sh:name "Région Administrative" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque AO doit être situé dans exactement une région (skos:Concept)."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_Category ;
        sh:name "Catégorie de Marché" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:ConceptScheme ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque AO doit appartenir à exactement un domaine (Travaux, Fournitures ou Services)."@fr ;
    ] ;

    # ── OPTIONAL OBJECT PROPERTIES ──────────────────────────────────────
    sh:property [
        sh:path ts:Is_Opened ;
        sh:name "PV d'ouverture" ;
        sh:maxCount 1 ;
        sh:class ts:TenderResults ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path ts:Has_specifications ;
        sh:maxCount 1 ;
        sh:class ts:TenderSpecifications ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:Has_Reglement_Consultation ;
        sh:maxCount 1 ;
        sh:class ts:TenderReglement ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:IsAwarded_to ;
        sh:maxCount 1 ;
        sh:class ts:Contractor ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
    ] .


#################################################################
#  ②  ts:Contractor — NodeShape
#################################################################

ts:ContractorShape
    a sh:NodeShape ;
    sh:targetClass ts:Contractor ;
    sh:name "ContractorShape"@en ;
    sh:description "Contraintes sur chaque instance d'Entrepreneur / Concurrent."@fr ;

    # ── IDENTITY ────────────────────────────────────────────────────────
    sh:property [
        sh:path ts:Has_Name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 2 ;
        sh:maxLength 200 ;
        sh:severity sh:Violation ;
        sh:message "La raison sociale de l'entreprise est obligatoire (2–200 caractères)."@fr ;
    ] ;

    # ── CONTACT ─────────────────────────────────────────────────────────
    sh:property [
        sh:path ts:Has_Mail ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[^@]+@[^@]+\\.[^@]+$" ;
        sh:severity sh:Warning ;
        sh:message "L'adresse email est invalide."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_Phone ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^(\\+212|0)[0-9]{9}$" ;
        sh:severity sh:Info ;
        sh:message "Le numéro de téléphone doit être au format marocain (+212 ou 0 suivi de 9 chiffres)."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_Adress ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:maxLength 300 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:Has_Contact ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:Has_Owner ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Info ;
    ] ;

    # ── OBJECT PROPERTIES ───────────────────────────────────────────────
    sh:property [
        sh:path ts:Formulate_Bid ;
        sh:class ts:TenderBids ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:message "Formulate_Bid doit pointer vers une instance de ts:TenderBids."@fr ;
    ] .


#################################################################
#  ③  ts:Buyers — NodeShape
#################################################################

ts:BuyersShape
    a sh:NodeShape ;
    sh:targetClass ts:Buyers ;
    sh:name "BuyersShape"@en ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Chaque acheteur public doit avoir un rdfs:label (nom de l'organisme)."@fr ;
    ] ;
    sh:property [
        sh:path ts:Launched ;
        sh:class ts:Tenders ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
    ] .


#################################################################
#  ④  ts:TenderBids — NodeShape
#################################################################

ts:TenderBidsShape
    a sh:NodeShape ;
    sh:targetClass ts:TenderBids ;
    sh:name "TenderBidsShape"@en ;

    # ── FINANCIAL ───────────────────────────────────────────────────────
    sh:property [
        sh:path ts:Bid_Amount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "Le montant de l'offre est obligatoire et ne peut pas être négatif."@fr ;
    ] ;
    sh:property [
        sh:path ts:Article_Bid ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "Le prix unitaire proposé ne peut pas être négatif."@fr ;
    ] ;
    sh:property [
        sh:path ts:Bid_For_Lot ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Info ;
    ] ;

    # ── REQUIRED RELATIONSHIPS ───────────────────────────────────────────
    sh:property [
        sh:path ts:Is_Bid_of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:Contractor ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque offre doit être liée à exactement un entrepreneur (ts:Contractor)."@fr ;
    ] ;
    sh:property [
        sh:path ts:Is_Bid_in ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:TenderResults ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque offre doit être liée à exactement un PV d'ouverture (ts:TenderResults)."@fr ;
    ] .


#################################################################
#  ⑤  ts:TenderResults — NodeShape
#################################################################

ts:TenderResultsShape
    a sh:NodeShape ;
    sh:targetClass ts:TenderResults ;
    sh:name "TenderResultsShape"@en ;

    sh:property [
        sh:path ts:Has_Date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "La date du PV d'ouverture est obligatoire."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_Status ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "Ouvert" "Attribué" "Infructueux" "Résilié" "Annulé" ) ;
        sh:severity sh:Violation ;
        sh:message "Le statut doit être l'un des suivants : Ouvert, Attribué, Infructueux, Résilié, Annulé."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_PV ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:severity sh:Info ;
    ] ;

    # ── REQUIRED RELATIONSHIPS ───────────────────────────────────────────
    sh:property [
        sh:path ts:Is_Proces_Verbal_of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:Tenders ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque PV doit être lié à exactement un Appel d'Offres."@fr ;
    ] ;
    sh:property [
        sh:path ts:Is_Winner_Bid ;
        sh:maxCount 1 ;
        sh:class ts:TenderBids ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path ts:Has_Bid ;
        sh:class ts:TenderBids ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path ts:Rejected_Bid ;
        sh:class ts:TenderBids ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Info ;
    ] .


#################################################################
#  ⑥  ts:Bordereaux & ts:Articles — NodeShapes
#################################################################

ts:BordereauxShape
    a sh:NodeShape ;
    sh:targetClass ts:Bordereaux ;
    sh:name "BordereauxShape"@en ;

    sh:property [
        sh:path ts:Has_Bordereau_Doc ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:Has_Article ;
        sh:class ts:Articles ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:Is_Bordereau_of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:Tenders ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque bordereau doit être lié à exactement un Appel d'Offres."@fr ;
    ] .


ts:ArticlesShape
    a sh:NodeShape ;
    sh:targetClass ts:Articles ;
    sh:name "ArticlesShape"@en ;

    sh:property [
        sh:path ts:Has_Designation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 3 ;
        sh:severity sh:Violation ;
        sh:message "La désignation de l'article est obligatoire (min. 3 caractères)."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_Unit ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "U" "ML" "M2" "M3" "FF" "KG" "T" "H" "J" "Mois" "Km" "L" ) ;
        sh:severity sh:Warning ;
        sh:message "L'unité de mesure doit être l'une des unités normalisées (U, ML, M2, M3, FF, KG, ...)."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_quantity ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:severity sh:Warning ;
        sh:message "La quantité estimée ne peut pas être négative."@fr ;
    ] ;
    sh:property [
        sh:path ts:Has_Article_Category ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:Is_Article_of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:Bordereaux ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque article doit être lié à exactement un Bordereau des Prix."@fr ;
    ] .


#################################################################
#  ⑦  ts:TenderSpecifications — NodeShape
#################################################################

ts:TenderSpecificationsShape
    a sh:NodeShape ;
    sh:targetClass ts:TenderSpecifications ;
    sh:name "TenderSpecificationsShape"@en ;

    sh:property [
        sh:path ts:Has_CPS_Doc ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path ts:Has_Spec_Vector ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:Is_specifications_of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:Tenders ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque CPS doit être lié à exactement un Appel d'Offres."@fr ;
    ] .


#################################################################
#  ⑧  ts:TenderReglement — NodeShape
#################################################################

ts:TenderReglementShape
    a sh:NodeShape ;
    sh:targetClass ts:TenderReglement ;
    sh:name "TenderReglementShape"@en ;

    sh:property [
        sh:path ts:Has_RC_Doc ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path ts:Has_Reglement_Vector ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ts:Is_Reglement_Consultation_Of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:Tenders ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Chaque RC doit être lié à exactement un Appel d'Offres."@fr ;
    ] .


#################################################################
#  ⑨  SPARQL-Based Cross-Class Constraints
#################################################################

# RULE 1: Winner Bid must also appear in Has_Bid ────────────────────────
ts:WinnerBidConsistencyShape
    a sh:NodeShape ;
    sh:targetClass ts:TenderResults ;
    sh:sparql [
        sh:message "ts:Is_Winner_Bid doit pointer vers une offre également référencée via ts:Has_Bid."@fr ;
        sh:prefixes [
            sh:declare [ sh:prefix "ts" ; sh:namespace "http://www.tenderintelligence.io/ontology/tender-structure#"^^xsd:anyURI ]
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this ts:Is_Winner_Bid ?winner .
                FILTER NOT EXISTS { $this ts:Has_Bid ?winner }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .


# RULE 2: Deadline must be before the PV date ───────────────────────────
ts:DeadlineBeforePVShape
    a sh:NodeShape ;
    sh:targetClass ts:Tenders ;
    sh:sparql [
        sh:message "La date limite (Has_Deadline) doit être antérieure ou égale à la date du PV (Has_Date)."@fr ;
        sh:prefixes [
            sh:declare [ sh:prefix "ts" ; sh:namespace "http://www.tenderintelligence.io/ontology/tender-structure#"^^xsd:anyURI ]
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this ts:Has_Deadline ?deadline .
                $this ts:Is_Opened/ts:Has_Date ?pvDate .
                FILTER (?deadline > ?pvDate)
            }
        """ ;
        sh:severity sh:Warning ;
    ] .


# RULE 3: Caution ≤ 3% of Budget (Décret marocain 2-22-431) ────────────
ts:CautionRatioShape
    a sh:NodeShape ;
    sh:targetClass ts:Tenders ;
    sh:sparql [
        sh:message "La caution provisoire ne doit pas dépasser 3% du budget estimatif (Décret 2-22-431)."@fr ;
        sh:prefixes [
            sh:declare [ sh:prefix "ts" ; sh:namespace "http://www.tenderintelligence.io/ontology/tender-structure#"^^xsd:anyURI ]
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this ts:Has_Caution ?caution .
                $this ts:Has_Budget ?budget .
                FILTER (?caution > ?budget * 0.03)
            }
        """ ;
        sh:severity sh:Violation ;
    ] .


# RULE 4: Region must belong to MoroccoRegionsScheme ───────────────────
ts:RegionConceptShape
    a sh:NodeShape ;
    sh:targetClass ts:Tenders ;
    sh:sparql [
        sh:message "ts:Is_Located_In doit pointer vers un concept issu de regions:MoroccoRegionsScheme."@fr ;
        sh:prefixes [
            sh:declare [ sh:prefix "ts"      ; sh:namespace "http://www.tenderintelligence.io/ontology/tender-structure#"^^xsd:anyURI ] ;
            sh:declare [ sh:prefix "skos"    ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
            sh:declare [ sh:prefix "regions" ; sh:namespace "http://www.tenderintelligence.io/ontology/morocco-regions#"^^xsd:anyURI ]
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this ts:Is_Located_In ?region .
                FILTER NOT EXISTS {
                    ?region skos:inScheme regions:MoroccoRegionsScheme
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .


# RULE 5: Has_Category must be one of the 3 known ConceptSchemes ────────
ts:CategorySchemeShape
    a sh:NodeShape ;
    sh:targetClass ts:Tenders ;
    sh:sparql [
        sh:message "ts:Has_Category doit être l'un des trois schémas : SchemeTravaux, SchemeFournitures ou SchemeServices."@fr ;
        sh:prefixes [
            sh:declare [ sh:prefix "ts"       ; sh:namespace "http://www.tenderintelligence.io/ontology/tender-structure#"^^xsd:anyURI ] ;
            sh:declare [ sh:prefix "activity" ; sh:namespace "http://www.tenderintelligence.io/ontology/activity-domains#"^^xsd:anyURI ]
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this ts:Has_Category ?scheme .
                FILTER (?scheme NOT IN (
                    activity:SchemeTravaux,
                    activity:SchemeFournitures,
                    activity:SchemeServices
                ))
            }
        """ ;
        sh:severity sh:Violation ;
    ] .


# RULE 6: Bid_For_Lot required when tender is multilot ──────────────────
ts:MultilotBidShape
    a sh:NodeShape ;
    sh:targetClass ts:TenderBids ;
    sh:sparql [
        sh:message "Quand le marché parent est alloti (Has_Multilot = true), chaque offre doit spécifier ts:Bid_For_Lot."@fr ;
        sh:prefixes [
            sh:declare [ sh:prefix "ts" ; sh:namespace "http://www.tenderintelligence.io/ontology/tender-structure#"^^xsd:anyURI ]
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this ts:Is_Bid_in/ts:Is_Proces_Verbal_of ?tender .
                ?tender ts:Has_Multilot true .
                FILTER NOT EXISTS { $this ts:Bid_For_Lot ?lot }
            }
        """ ;
        sh:severity sh:Warning ;
    ] .


# RULE 7: Contractor should be typed as a specialised subclass ──────────
ts:ContractorSubclassShape
    a sh:NodeShape ;
    sh:targetClass ts:Contractor ;
    sh:sparql [
        sh:message "Un Entrepreneur devrait être typé comme sous-classe spécialisée (EntrepriseTravaux, BureauEtude, Architecte, etc.)."@fr ;
        sh:prefixes [
            sh:declare [ sh:prefix "ts"  ; sh:namespace "http://www.tenderintelligence.io/ontology/tender-structure#"^^xsd:anyURI ] ;
            sh:declare [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ]
        ] ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    { $this a ts:EntrepriseTravaux } UNION
                    { $this a ts:EntrepriseServices } UNION
                    { $this a ts:BureauEtude } UNION
                    { $this a ts:BureauConsulting } UNION
                    { $this a ts:Architecte } UNION
                    { $this a ts:Fournisseur }
                }
            }
        """ ;
        sh:severity sh:Info ;
    ] .
