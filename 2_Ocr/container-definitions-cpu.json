[
    {
        "name": "ocr-cpu-container",
        "image": "034791378578.dkr.ecr.eu-west-3.amazonaws.com/ocr-cuda-container:latest",
        "cpu": 2048,
        "memory": 8192,
        "essential": true,
        "environment": [
            {
                "name": "AWS_REGION",
                "value": "eu-west-3"
            },
            {
                "name": "S3_BUCKET_NAME",
                "value": "my-tender-documents-bucket"
            },
            {
                "name": "OCR_QUEUE_URL",
                "value": "https://sqs.eu-west-3.amazonaws.com/034791378578/OCR_QUEUE"
            },
            {
                "name": "CLASSIFICATION_QUEUE_URL",
                "value": "https://sqs.eu-west-3.amazonaws.com/034791378578/CLASSIFICATION_QUEUE"
            },
            {
                "name": "MAX_RETRIES",
                "value": "3"
            },
            {
                "name": "VISIBILITY_TIMEOUT",
                "value": "900"
            },
            {
                "name": "CUDA_VISIBLE_DEVICES",
                "value": ""
            }
        ],
        "logConfiguration": {
            "logDriver": "awslogs",
            "options": {
                "awslogs-group": "/ecs/ocr-cuda-task",
                "awslogs-region": "eu-west-3",
                "awslogs-stream-prefix": "ocr-cpu"
            }
        }
    }
]
